generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum CohortStatus {
  ACTIVE
  ARCHIVED
}

enum AlertSeverity {
  DANGER
  WARNING
}

enum AlertType {
  DEVICE_SWITCH
  FULLSCREEN_EXIT
  TAB_HIDDEN
  COPY
  CUT
  PASTE_EXTERNAL
  DROP_EXTERNAL
  ATTEMPT_TERMINATED
}

enum TestType {
  MCQ
  CODING
}

enum TestStatus {
  DRAFT
  PUBLISHED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  TERMINATED
}

enum ViolationType {
  FULLSCREEN_EXIT
  TAB_HIDDEN
  COPY
  CUT
  PASTE_EXTERNAL
  DROP_EXTERNAL
  NEW_SESSION // old rows only (before Alpha)
  DEVICE_SWITCH // sent by the server only
}

enum TestCaseVisibility {
  SAMPLE
  HIDDEN
}

model User {
  id                Int                @id @default(autoincrement())
  fullName          String             @map("full_name")
  email             String             @unique
  passwordHash      String             @map("password_hash")
  role              Role
  cohortId          Int?               @map("cohort_id")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  cohort            Cohort?            @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  attempts          Attempt[]
  instructorCohorts CohortInstructor[]
  sessions          UserSession[]
  alertsAbout       Alert[]            @relation("AlertStudent")
  alertsRead        Alert[]            @relation("AlertReader")

  @@index([cohortId])
  @@map("users")
}

model Test {
  id              Int        @id @default(autoincrement())
  title           String
  type            TestType
  order           Int
  durationMinutes Int        @map("duration_minutes")
  status          TestStatus @default(DRAFT)
  cohortId        Int        @map("cohort_id")
  sourceTestId    Int?       @map("source_test_id")
  cohort          Cohort     @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  questions       Question[]
  problems        Problem[]
  attempts        Attempt[]

  @@unique([cohortId, order])
  @@map("tests")
}

model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  cohorts   Cohort[]

  @@map("cities")
}

model Cohort {
  id          Int                @id @default(autoincrement())
  name        String
  cityId      Int                @map("city_id")
  joinCode    String             @unique @map("join_code")
  status      CohortStatus       @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  archivedAt  DateTime?          @map("archived_at")
  city        City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  students    User[]
  tests       Test[]
  instructors CohortInstructor[]
  alerts      Alert[]

  @@unique([cityId, name])
  @@map("cohorts")
}

model CohortInstructor {
  cohortId  Int      @map("cohort_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cohortId, userId])
  @@map("cohort_instructors")
}

model UserSession {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model Alert {
  id        Int           @id @default(autoincrement())
  cohortId  Int           @map("cohort_id")
  attemptId Int           @map("attempt_id")
  studentId Int           @map("student_id")
  type      AlertType
  severity  AlertSeverity
  message   String
  createdAt DateTime      @default(now()) @map("created_at")
  readAt    DateTime?     @map("read_at")
  readById  Int?          @map("read_by_id")
  cohort    Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  attempt   Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student   User          @relation("AlertStudent", fields: [studentId], references: [id], onDelete: Cascade)
  readBy    User?         @relation("AlertReader", fields: [readById], references: [id], onDelete: SetNull)

  @@index([cohortId, readAt])
  @@index([cohortId, createdAt])
  @@map("alerts")
}

model Question {
  id       Int         @id @default(autoincrement())
  testId   Int         @map("test_id")
  text     String
  position Int
  test     Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  options  Option[]
  answers  McqAnswer[]

  @@map("questions")
}

model Option {
  id         Int         @id @default(autoincrement())
  questionId Int         @map("question_id")
  text       String
  isCorrect  Boolean     @map("is_correct")
  position   Int
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    McqAnswer[]

  @@map("options")
}

model Problem {
  id           Int             @id @default(autoincrement())
  testId       Int             @map("test_id")
  title        String
  description  String
  functionName String          @map("function_name")
  points       Int
  position     Int
  test         Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  testCases    TestCase[]
  results      ProblemResult[]

  @@map("problems")
}

model TestCase {
  id         Int                @id @default(autoincrement())
  problemId  Int                @map("problem_id")
  visibility TestCaseVisibility
  args       Json
  expected   Json
  position   Int
  problem    Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model Attempt {
  id                Int                @id @default(autoincrement())
  userId            Int                @map("user_id")
  testId            Int                @map("test_id")
  status            AttemptStatus      @default(IN_PROGRESS)
  startedAt         DateTime           @map("started_at")
  deadline          DateTime
  submittedAt       DateTime?          @map("submitted_at")
  terminatedAt      DateTime?          @map("terminated_at")
  terminationReason String?            @map("termination_reason")
  score             Float?
  sessionKey        String?            @map("session_key")
  questionOrder     Json?              @map("question_order")
  optionOrder       Json?              @map("option_order")
  user              User               @relation(fields: [userId], references: [id])
  test              Test               @relation(fields: [testId], references: [id])
  mcqAnswers        McqAnswer[]
  problemResults    ProblemResult[]
  violations        AttemptViolation[]
  alerts            Alert[]

  @@unique([userId, testId])
  @@index([testId, status])
  @@map("attempts")
}

model McqAnswer {
  id         Int      @id @default(autoincrement())
  attemptId  Int      @map("attempt_id")
  questionId Int      @map("question_id")
  optionId   Int?     @map("option_id")
  isCorrect  Boolean  @map("is_correct")
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])
  option     Option?  @relation(fields: [optionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("mcq_answers")
}

model ProblemResult {
  id          Int       @id @default(autoincrement())
  attemptId   Int       @map("attempt_id")
  problemId   Int       @map("problem_id")
  runCount    Int       @default(0) @map("run_count")
  code        String?
  passedCount Int?      @map("passed_count")
  totalCount  Int?      @map("total_count")
  points      Float?
  submittedAt DateTime? @map("submitted_at")
  attempt     Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problem     Problem   @relation(fields: [problemId], references: [id])

  @@unique([attemptId, problemId])
  @@map("problem_results")
}

model AttemptViolation {
  id         Int           @id @default(autoincrement())
  attemptId  Int           @map("attempt_id")
  type       ViolationType
  counted    Boolean
  occurredAt DateTime      @default(now()) @map("occurred_at")
  attempt    Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
  @@map("attempt_violations")
}
